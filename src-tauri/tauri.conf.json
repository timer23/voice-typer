{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Typer",
  "version": "0.1.0",
  "identifier": "com.voicetyper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-close",
            "opener:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "title": "Voice Typer",
        "width": 220,
        "height": 106,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
